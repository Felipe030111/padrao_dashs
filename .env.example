# Copie para .env e preencha. NUNCA versione o .env.
# Em produção, cadastre estas variáveis no painel do host (o .env não vai para a imagem).

# --- Acesso (Postgres, só usuários) ---
# DSN libpq: "host=... port=... user=... password=... dbname=<projeto>_bi"
APP_DB_DSN=host=HOST port=PORTA user=USUARIO password=SENHA dbname=projeto_bi

# --- Dados (CatWorld) ---
CATWORLD_API_ROOT=https://catworld.77indicadores.com.br
CATWORLD_API_TOKEN=cw_live_xxxxxxxxxxxxxxxxxxxx        # escopo GLOBAL:WRITE
CATWORLD_DATASET_ID=00000000-0000-0000-0000-000000000000

# (opcional) leitura OData do ERP, se o projeto consumir poliview
CATWORLD_API_BASE=https://catworld.77indicadores.com.br/api/odata/<empresa>
CATWORLD_FTP_ENDPOINT=/poliview

# --- Flask ---
SECRET_KEY=troque-esta-chave-no-servidor
